FROM python:3.8-slim-bullseye

WORKDIR /home

RUN apt-get update && \
    apt-get install -y libmagic1 && \
    rm -rf /var/lib/apt/lists/*

COPY DataClean/requirements.txt requirements.txt

RUN pip install -r requirements.txt --user
RUN pip install scipy==1.8.0
RUN pip install scikit-learn==1.0.1
RUN pip install argparse==1.4.0
RUN pip install pyjanitor==0.23.1

COPY DataClean/app /home/app
COPY shared_components /home/shared_components

WORKDIR /home/app

ENV PYTHONPATH=/home

ENTRYPOINT ["python"]
CMD ["/home/shared_components/S.py"]
